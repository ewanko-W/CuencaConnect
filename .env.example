# Copy to .env.local and fill in values. Never commit .env.local.
# Local values are printed by `npx supabase start` (or `npm run db:start`).

# Supabase project URL (local default: http://127.0.0.1:54321)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (public) key. Safe for the browser; RLS protects the data.
VITE_SUPABASE_ANON_KEY=

# Web Push public VAPID key (Phase 10). The private key is stored only in
# Supabase secrets, never here.
VITE_VAPID_PUBLIC_KEY=
